# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# ============ EMAIL SERVICE (Resend) ============
# Get API key from: https://resend.com (free, no credit card needed)
RESEND_API_KEY="re_your_api_key_here"

# ============ GOOGLE OAUTH ============
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# ============ PASSWORD RESET SETTINGS ============
PASSWORD_RESET_EXPIRY="3600"
PASSWORD_RESET_EMAIL_SUBJECT="Reset Your AutoResearch Password"

# ============ RATE LIMITING ============
RATE_LIMIT_WINDOW="900000"
RATE_LIMIT_MAX_REQUESTS="5"

# ============ AUTH & TOKENS ============
# Secrets used to sign JWTs. Set strong random values in production.
JWT_SECRET="your_jwt_secret_here"
REFRESH_TOKEN_SECRET="your_refresh_token_secret_here"

# ============ MONGODB (persistence) ============
MONGODB_URI="mongodb://localhost:27017/"
MONGODB_DB="autoresearch"

# ============ EMAIL (Gmail) ============
# For production email sending using Gmail (app password) or set RESEND_API_KEY above.
GMAIL_EMAIL="your@gmail.com"
GMAIL_APP_PASSWORD="your_app_password"

# ============ RETENTION & EXPIRY ============
# File retention (days)
UPLOAD_RETENTION_DAYS="30"
# Refresh token retention for cleanup (days)
REFRESH_TOKEN_RETENTION_DAYS="30"
# Email verification token expiry (seconds)
EMAIL_VERIFICATION_EXPIRY="86400"
